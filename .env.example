# HiBot secrets — copy to `.env` (git-ignored) and fill in. NEVER commit `.env`.
# hibot reads it automatically (hibot/envfile.py); real environment variables win.

# --- Company LLM: ArGPT text-completion (no tool calling; see DECISIONS D7/D8)
HIBOT_LLM_FORMAT=argpt
HIBOT_LLM_URL=https://argptapi.arcelik.com/api/public/text-completion
HIBOT_LLM_CLIENT_ID=
HIBOT_LLM_API_KEY=
# HIBOT_LLM_TIMEOUT=120

# --- Read-only PROD DB (db_datareader-only login!). ODBC connection strings.
# Azure SQL + SQL login example:
# HIBOT_DB_EU=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.database.windows.net,1433;Database=<db>;Uid=<user>;Pwd=<password>;Encrypt=yes;TrustServerCertificate=no
# Azure AD (Entra) user example:
# HIBOT_DB_EU=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.database.windows.net,1433;Database=<db>;Authentication=ActiveDirectoryInteractive;UID=<user@company.com>;Encrypt=yes
HIBOT_DB_EU=
HIBOT_DB_APAC=
ANTHROPIC_API_KEY=
# Only needed when the API key is not scoped to a workspace (Console > Settings > Workspaces > ID)
ANTHROPIC_WORKSPACE_ID=

# HiBot HTTP service (python -m hibot.service): shared secret the DbChangeTracking API sends as X-HiBot-Key
HIBOT_SERVICE_KEY=
