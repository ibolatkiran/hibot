# Raw source data (PII, large) — kept on disk, documented in CLAUDE.md
docs/*.json
docs/*.html
docs/jira_export/raw/

# Generated knowledge (regenerate with tools/*/build.py); READMEs, md reports and query templates stay tracked
knowledge/**/*.json
# ...except learned knowledge, which cannot be regenerated: known-issue cards (feedback/*.jsonl is tracked too)
!knowledge/cards/*.json
# ...and the evaluation set + scored results (no PII; checked by tests/test_eval.py)
!knowledge/eval/*.json

# Runtime
logs/
runs/
# Batch learning raw output is derived from PROD data (kept local); summary .md files stay tracked
knowledge/learning/*.jsonl
knowledge/learning/checkpoint*
.env
.env.*
!.env.example
*.pfx

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
